# Dependencies
node_modules/

# Build output. dist/ is NOT shipped via npm install -g — the package
# ships `src/` directly and the `cartograph` bin points at
# `src/bin/cartograph.ts` with a `#!/usr/bin/env bun` shebang. Bun
# transpiles the TypeScript on demand, no install-time build step
# needed (which sidesteps the npm-9+-doesn't-install-devDeps-on-git-
# install bug). `npm run build` still works for type-checking + dist
# generation for library consumers; dist/ stays local.
dist/

# Docker-extracted libcgshim artifact — produced by
# `docker build -f docker/libcgshim/Dockerfile .` + `docker cp`.
# Cross-platform prebuilts ship via the build-libcgshim CI workflow as
# release assets; the local extraction directory is for development
# iteration only.
docker/libcgshim/build/

.cmem

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test coverage
/coverage/
.nyc_output/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo

# SQLite WAL mode files
*.db-wal
*.db-shm

# Local Claude settings
.claude/settings.local.json

# Local MCP server config — typically contains machine-specific
# absolute paths (e.g. --project-path) and shouldn't be shared.
.mcp.json

# Cartograph data directories (in test projects)
.cartograph/

test_frameworks

# Test language repos for manual testing
test-languages/

# Eval-harness reports (accumulate per-run; keep ignored, baseline
# reports get checked in explicitly when needed)
__tests__/evaluation/results/

# Synthesised large-scale fixture for the B7 latency-budget eval.
# Regenerated on demand via `npm run eval:large`; never committed.
__tests__/evaluation/fixtures/large/

# Local archive of stale design docs / session memos — kept on disk
# for reference but never pushed.
docs/archive/

nul
