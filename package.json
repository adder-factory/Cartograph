{
  "name": "@adder-factory/cartograph",
  "version": "1.1.27",
  "description": "Local-first code intelligence for AI coding agents with CLI, MCP, SQLite, and PostgreSQL support.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    }
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "cartograph": "./src/bin/cartograph.ts"
  },
  "files": [
    "src",
    "scripts",
    "docs/assets/viewer.png",
    "docs/assets/viewer-graph.png",
    "docs/assets/viewer-health.png",
    "docs/assets/viewer-trace.png",
    "docs/assets/viewer-live.png",
    "docs/assets/viewer-system.png",
    "docs/assets/viewer-tour.webp",
    "docs/AGENT-INSTALL.md",
    "docs/ADDING-A-LANGUAGE.md",
    "docs/CLI-REFERENCE.md",
    "docs/CONFIGURATION.md",
    "docs/GRAMMAR-ASSETS.md",
    "docs/GRAPH-EXPORT-FORMATS.md",
    "docs/MCP-USAGE.md",
    "docs/STORAGE-BACKENDS.md",
    "docs/SUPPORT-MATRIX.md",
    "docs/TROUBLESHOOTING.md",
    "docs/VIEWER.md",
    "bench/README.md",
    "bench/storage-backends.mts",
    "bench/sqlite-driver.mts",
    "README.md",
    "ACKNOWLEDGEMENTS.md",
    "install.sh",
    "install.ps1"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "build:standalone": "bun scripts/build-standalone.mjs",
    "build:release": "bun run build && bun run build:standalone",
    "preuninstall": "bun src/bin/uninstall.ts",
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "cli": "bun src/bin/cartograph.ts",
    "cli:dev": "bun src/bin/cartograph.ts",
    "test": "CARTOGRAPH_HOOKS_IN_PROCESS=1 CARTOGRAPH_TRACK_CONSUMED_ARGS=1 CARTOGRAPH_BIOMARKER_SERIAL=1 CARTOGRAPH_BIOMARKER_PERFILE_WORKERS=0 bash scripts/test-parallel.sh",
    "test:watch": "CARTOGRAPH_HOOKS_IN_PROCESS=1 CARTOGRAPH_TRACK_CONSUMED_ARGS=1 CARTOGRAPH_BIOMARKER_SERIAL=1 CARTOGRAPH_BIOMARKER_PERFILE_WORKERS=0 bun test --isolate --watch --timeout 30000 __tests__/*.test.ts",
    "test:fast": "CARTOGRAPH_HOOKS_IN_PROCESS=1 CARTOGRAPH_TRACK_CONSUMED_ARGS=1 CARTOGRAPH_BIOMARKER_SERIAL=1 CARTOGRAPH_BIOMARKER_PERFILE_WORKERS=0 bash scripts/test-parallel.sh",
    "test:eval": "CARTOGRAPH_HOOKS_IN_PROCESS=1 CARTOGRAPH_TRACK_CONSUMED_ARGS=1 bun test --timeout 60000 __tests__/evaluation/",
    "test:leaks": "node scripts/check-test-module-leaks.mjs",
    "test:mock-hygiene": "node scripts/check-test-mock-hygiene.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:viewer-smoke": "bun scripts/viewer-smoke.ts",
    "test:viewer-smoke:required": "VIEWER_SMOKE_REQUIRED=1 bun scripts/viewer-smoke.ts",
    "test:stress": "CARTOGRAPH_HOOKS_IN_PROCESS=1 CARTOGRAPH_TRACK_CONSUMED_ARGS=1 STRESS=1 bun test --timeout 120000 __tests__/freshness-stress.test.ts __tests__/freshness-v2-stress.test.ts",
    "test:coverage": "CARTOGRAPH_HOOKS_IN_PROCESS=1 CARTOGRAPH_TRACK_CONSUMED_ARGS=1 COVERAGE=1 node scripts/test-coverage-merge.mjs",
    "test:managed-backend-smoke": "bun scripts/managed-backend-e2e-smoke.ts",
    "test:clean-install:docker": "bash scripts/docker-clean-install-smoke.sh",
    "eval": "npm run build && bun __tests__/evaluation/runner.ts",
    "eval:self": "bun __tests__/evaluation/runner.ts . --cases self",
    "eval:large": "bun __tests__/evaluation/gen-large-fixture.ts && bun __tests__/evaluation/runner.ts __tests__/evaluation/fixtures/large --cases large",
    "bench:sqlite-driver": "bun bench/sqlite-driver.mts",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "npm run check:architecture && npm run check:biome",
    "check:fix": "biome check --write",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:biome": "biome check",
    "check:biomarkers": "bun scripts/check-biomarkers.mjs",
    "check:ci-portability": "node scripts/check-ci-portability.mjs",
    "check:mcp-load": "bun scripts/check-mcp-load-budget.ts",
    "check:release": "bash scripts/release-audit.sh",
    "quality:full": "bash scripts/quality-full.sh",
    "measure:mcp-load": "bun scripts/measure-mcp-load.ts",
    "benchmark:tokens": "bun scripts/benchmark-token-savings.ts",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "test:ci-unit": "bash scripts/test-ci-unit.sh"
  },
  "keywords": [
    "ai-coding-agents",
    "code-intelligence",
    "code-search",
    "developer-tools",
    "knowledge-graph",
    "local-first",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "semantic-search",
    "sqlite",
    "static-analysis",
    "tree-sitter",
    "typescript"
  ],
  "author": "Adder Factory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adder-factory/cartograph.git"
  },
  "bugs": {
    "url": "https://github.com/adder-factory/cartograph/issues"
  },
  "homepage": "https://github.com/adder-factory/cartograph#readme",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@parcel/watcher": "^2.5.6",
    "commander": "^15.0.0",
    "openai": "^6.45.0",
    "re2-wasm": "^1.0.2",
    "web-tree-sitter": "^0.26.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "playwright": "^1.61.1",
    "tree-sitter-cli": "^0.26.10",
    "tree-sitter-sfapex": "3.0.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9",
    "usearch": "^2.25.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "tree-sitter-cli",
    "usearch"
  ]
}
