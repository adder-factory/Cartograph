{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "wip"
  },
  "files": {
    "includes": [
      "src/**",
      "__tests__/**",
      "bench/**",
      "scripts/**",
      "!**/dist",
      "!**/node_modules",
      "!**/.cartograph",
      "!**/build",
      "!**/*.wasm",
      "!**/*.gguf",
      "!src/extraction/wasm",
      "!scripts/spikes",
      "!bench/mini-nllc/_archive",
      "!src/features/viewer/static"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off",
        "noEmptyBlockStatements": "off",
        "noAssignInExpressions": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": "warn",
        "noConstantBinaryExpressions": "error"
      },
      "nursery": {
        "useAwaitThenable": "error",
        "noFloatingPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error",
        "useExportType": "error",
        "useNamingConvention": "off",
        "noParameterAssign": "off",
        "useTemplate": "off",
        "useNumberNamespace": "off",
        "noUnusedTemplateLiteral": "off",
        "useNodejsImportProtocol": "off"
      },
      "complexity": {
        "noUselessConstructor": "off",
        "noForEach": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off",
        "noUselessEscapeInRegex": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "off",
        "noUnusedFunctionParameters": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "a11y": {
        "useButtonType": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
